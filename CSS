:root {
  --bg: #050505;
  --surface: #0d0d11;
  --surface-2: #15151c;
  --border: rgba(255, 255, 255, 0.09);
  --text: #f8fafc;
  --muted: #94a3b8;
  --accent: #e11d48;
  --accent-hover: #be123c;
  --ok: #10b981;
  --warn: #f59e0b;
  --font-display: 'Outfit', sans-serif;
  --font-body: 'Plus Jakarta Sans', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: radial-gradient(circle at top right, rgba(225, 29, 72, 0.12), transparent 42%), var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
code { font-family: var(--font-mono); font-size: 0.85em; }
.hidden { display: none !important; }
.muted { color: var(--muted); font-size: 0.92rem; }
.container { width: min(1200px, 92%); margin: 0 auto; }

/* Navbar */
.navbar {
  position: sticky;
  top: 0;
  z-index: 40;
  backdrop-filter: blur(14px);
  background: rgba(5, 5, 5, 0.82);
  border-bottom: 1px solid var(--border);
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 68px;
}
.brand { display: flex; align-items: center; gap: 12px; }
.brand-mark {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: #fff;
  font-size: 0.95rem;
}
.brand-title { display: block; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; }
.brand-sub { display: block; color: var(--muted); font-size: 0.76rem; }
.nav-links { display: flex; gap: 22px; font-size: 0.92rem; color: var(--muted); }
.nav-links a:hover { color: var(--text); }
.nav-actions { display: flex; align-items: center; gap: 10px; }

.ref-chip, .owner-badge {
  padding: 5px 10px;
  border-radius: 8px;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  border: 1px solid var(--border);
  background: var(--surface-2);
}
.owner-badge { border-color: rgba(16, 185, 129, 0.4); color: #6ee7b7; }

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: 10px;
  padding: 10px 18px;
  font: 600 0.9rem var(--font-body);
  cursor: pointer;
  transition: 0.18s ease;
  color: var(--text);
  background: transparent;
}
.btn:disabled { opacity: 0.45; cursor: not-allowed; }
.btn-sm { padding: 7px 12px; font-size: 0.82rem; border-radius: 8px; }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover:not(:disabled) { background: var(--accent-hover); }
.btn-ghost { background: rgba(255, 255, 255, 0.05); border-color: var(--border); }
.btn-ghost:hover:not(:disabled) { background: rgba(255, 255, 255, 0.1); }
.btn-danger { background: rgba(225, 29, 72, 0.16); border-color: rgba(225, 29, 72, 0.45); color: #fda4af; }
.btn-danger:hover { background: var(--accent); color: #fff; }

/* Banners */
.notice-banner, .ref-banner {
  margin-top: 16px;
  padding: 12px 16px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--surface);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 0.9rem;
}
.ref-banner { border-color: rgba(225, 29, 72, 0.35); background: rgba(225, 29, 72, 0.08); }

/* Hero */
.hero-section { padding: 48px 0 32px; }
.hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 36px; align-items: center; }
.eyebrow {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.76rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #fb7185;
  margin-bottom: 10px;
}
.hero-title { font-family: var(--font-display); font-size: clamp(2.2rem, 4.5vw, 3.6rem); margin: 0 0 10px; line-height: 1.08; }
.hero-tagline { font-size: 1.12rem; font-weight: 600; margin: 0 0 10px; color: #e2e8f0; }
.hero-bio { color: var(--muted); margin: 0 0 22px; max-width: 58ch; }
.hero-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 26px; }

.stats-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.stat-box {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
}
.stat-val { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; }
.stat-lbl { color: var(--muted); font-size: 0.75rem; }

.hero-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease;
}
.hero-card:hover { transform: translateY(-3px); border-color: rgba(225, 29, 72, 0.5); }
.hero-card-media { position: relative; aspect-ratio: 16 / 9; background: #000; }
.hero-card-media img { width: 100%; height: 100%; object-fit: cover; }
.hero-card-body { padding: 18px; }
.hero-card-body h2 { font-family: var(--font-display); font-size: 1.25rem; margin: 8px 0 4px; }

/* Creator Toolbar */
.creator-toolbar {
  margin: 12px 0 8px;
  padding: 14px 16px;
  border-radius: 14px;
  background: var(--surface);
  border: 1px solid rgba(225, 29, 72, 0.35);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.toolbar-left, .vis-filters { display: flex; flex-wrap: wrap; gap: 8px; }
.vis-btn {
  padding: 6px 12px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--surface-2);
  color: var(--muted);
  cursor: pointer;
  font: 600 0.8rem var(--font-body);
}
.vis-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

/* Sections & Library */
.section { padding: 40px 0; }
.section-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  margin-bottom: 20px;
}
.section-head h2 { font-family: var(--font-display); font-size: 1.7rem; margin: 0 0 4px; }
.search-box input {
  width: min(320px, 85vw);
  padding: 10px 14px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  font: inherit;
}

.category-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
.cat-btn {
  padding: 7px 14px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--muted);
  cursor: pointer;
  font: 500 0.86rem var(--font-body);
}
.cat-btn.active, .cat-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }

/* Grids */
.video-grid, .ref-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 20px;
}
.video-card, .ref-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, border-color 0.2s ease;
}
.video-card { cursor: pointer; }
.video-card:hover, .ref-card:hover { transform: translateY(-3px); border-color: rgba(225, 29, 72, 0.45); }

.thumb-wrap { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; }
.thumb-wrap img { width: 100%; height: 100%; object-fit: cover; }
.duration-pill, .featured-pill {
  position: absolute;
  bottom: 10px;
  padding: 3px 8px;
  border-radius: 6px;
  font: 600 0.74rem var(--font-mono);
  background: rgba(5, 5, 5, 0.84);
  border: 1px solid var(--border);
}
.duration-pill { right: 10px; }
.featured-pill { left: 10px; background: var(--accent); border-color: var(--accent); }
.play-overlay {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(0, 0, 0, 0.28);
  opacity: 0;
  transition: opacity 0.2s ease;
}
.video-card:hover .play-overlay, .hero-card:hover .play-overlay { opacity: 1; }
.play-overlay span {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: #fff;
  font-size: 1.15rem;
}

.card-body { padding: 16px; display: flex; flex-direction: column; flex: 1; gap: 8px; }
.card-top-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.cat-tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: #fb7185;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.badge {
  padding: 2px 7px;
  border-radius: 6px;
  font-size: 0.72rem;
  font-weight: 600;
  border: 1px solid var(--border);
}
.badge-ok { color: #6ee7b7; border-color: rgba(16, 185, 129, 0.4); }
.badge-warn { color: #fcd34d; border-color: rgba(245, 158, 11, 0.4); }
.badge-accent { color: #fda4af; border-color: rgba(225, 29, 72, 0.4); }
.card-title { margin: 0; font-family: var(--font-display); font-size: 1.12rem; }
.card-desc {
  margin: 0;
  color: var(--muted);
  font-size: 0.88rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-foot {
  margin-top: auto;
  padding-top: 10px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  color: var(--muted);
}
.card-actions { display: flex; gap: 6px; }
.btn-icon {
  padding: 4px 8px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--surface-2);
  color: var(--text);
  cursor: pointer;
  font-size: 0.75rem;
}

.ref-card { padding: 18px; gap: 10px; }
.ref-card h3 { margin: 0; font-family: var(--font-display); font-size: 1.15rem; }
.ref-foot {
  margin-top: auto;
  padding-top: 10px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.ref-code {
  padding: 4px 8px;
  border-radius: 6px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: #cbd5e1;
  word-break: break-all;
}
.ref-actions { display: flex; gap: 6px; }

.about-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 28px;
}
.about-meta { display: flex; flex-wrap: wrap; gap: 18px; color: var(--muted); font-size: 0.88rem; }

.footer { border-top: 1px solid var(--border); padding: 24px 0; margin-top: 24px; }
.footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 0.88rem; }

/* Skeleton & Empty */
.skeleton-card {
  height: 290px;
  background: linear-gradient(90deg, var(--surface) 25%, var(--surface-2) 50%, var(--surface) 75%);
  background-size: 200% 100%;
  animation: pulse 1.3s infinite linear;
}
@keyframes pulse { to { background-position: -200% 0; } }
.empty-state {
  grid-column: 1 / -1;
  padding: 42px 20px;
  text-align: center;
  background: var(--surface);
  border: 1px dashed var(--border);
  border-radius: 14px;
}

/* Modals & Player */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(0, 0, 0, 0.84);
  backdrop-filter: blur(8px);
  display: grid;
  place-items: center;
  padding: 16px;
  overflow-y: auto;
}
.modal-box {
  width: min(580px, 100%);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 22px;
  max-height: 92vh;
  overflow-y: auto;
}
.modal-lg { width: min(1040px, 100%); }
.modal-sm { width: min(420px, 100%); }
.modal-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; margin-bottom: 16px; }
.modal-head h3 { margin: 0; font-family: var(--font-display); }
.modal-close {
  border: 1px solid var(--border);
  background: var(--surface-2);
  color: var(--text);
  width: 34px;
  height: 34px;
  border-radius: 8px;
  font-size: 1.3rem;
  cursor: pointer;
}

.player-layout { display: grid; grid-template-columns: 1fr 290px; gap: 20px; }
.player-stage { position: relative; aspect-ratio: 16 / 9; background: #000; border-radius: 12px; overflow: hidden; }
.video-frame-wrap, .video-frame-wrap iframe, .video-frame-wrap video { width: 100%; height: 100%; border: 0; display: block; }

.ad-overlay {
  position: absolute;
  inset: 0;
  z-index: 5;
  background: rgba(5, 5, 5, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 20px;
  gap: 10px;
}
.ad-badge-row { display: flex; gap: 10px; align-items: center; }
.ad-phase, .ad-timer {
  padding: 4px 10px;
  border-radius: 6px;
  font: 600 0.76rem var(--font-mono);
}
.ad-phase { background: rgba(225, 29, 72, 0.2); color: #fda4af; }
.ad-timer { background: var(--surface-2); border: 1px solid var(--border); }
.ad-image-wrap img { max-height: 110px; border-radius: 8px; }
.ad-overlay h4 { margin: 4px 0 0; font-family: var(--font-display); font-size: 1.25rem; }

.player-info { margin-top: 14px; display: flex; flex-direction: column; gap: 10px; }
.player-info p { margin: 0; color: var(--muted); }
.player-sidebar h4 { margin: 0 0 10px; font-family: var(--font-display); }
.upnext-list { display: flex; flex-direction: column; gap: 10px; }
.upnext-item {
  display: grid;
  grid-template-columns: 96px 1fr;
  gap: 10px;
  text-align: left;
  padding: 6px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--surface-2);
  color: var(--text);
  cursor: pointer;
}
.upnext-item img { width: 96px; height: 54px; object-fit: cover; border-radius: 6px; }
.upnext-title { font-weight: 600; font-size: 0.85rem; }
.upnext-meta { color: var(--muted); font-size: 0.75rem; }

/* Forms */
.form-grid { display: flex; flex-direction: column; gap: 12px; }
.field-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
.field { display: flex; flex-direction: column; gap: 5px; font-size: 0.86rem; }
.field span { color: #cbd5e1; font-weight: 500; }
.field input, .field select, .field textarea {
  width: 100%;
  padding: 9px 12px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--surface-2);
  color: var(--text);
  font: inherit;
}
.check-row { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; cursor: pointer; }
.form-error { margin: 0; color: #fb7185; font-size: 0.86rem; }
.modal-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; margin-top: 6px; }

.site-ref-box {
  padding: 14px;
  border-radius: 12px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  margin-bottom: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.site-ref-row { display: flex; gap: 8px; }
.owner-ref-list { margin-top: 18px; display: flex; flex-direction: column; gap: 8px; }
.owner-ref-row {
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--surface-2);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}
.row-btns { display: flex; gap: 6px; }

/* Toast */
.toast {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 80;
  padding: 12px 18px;
  border-radius: 10px;
  background: var(--surface-2);
  border: 1px solid rgba(225, 29, 72, 0.5);
  color: var(--text);
  font-size: 0.9rem;
  opacity: 0;
  transform: translateY(12px);
  pointer-events: none;
  transition: 0.2s ease;
}
.toast.show { opacity: 1; transform: translateY(0); }

@media (max-width: 900px) {
  .hero-grid, .player-layout { grid-template-columns: 1fr; }
  .nav-links { display: none; }
  .stats-strip { grid-template-columns: repeat(2, 1fr); }
}